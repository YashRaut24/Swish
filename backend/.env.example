# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Database
# Local dev example; replace with your own connection string
MONGO_URI=mongodb://127.0.0.1:27017/swish

# Authentication
# Replace with strong, unique secrets
JWT_SECRET=replace-with-a-strong-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (optional)
# Replace with your Cloudinary credentials if using media uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Environment
NODE_ENV=development
